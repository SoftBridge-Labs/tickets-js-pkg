{
  "name": "@softbridgelabs/tickets",
  "version": "1.0.0",
  "description": "Framework-agnostic browser SDK and embeddable widget for SoftBridge Tickets customer support.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftBridge-Labs/tickets-js-pkg.git"
  },
  "homepage": "https://office.softbridgelabs.in/products/tickets",
  "bugs": {
    "url": "https://github.com/SoftBridge-Labs/tickets-js-pkg/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "support",
    "tickets",
    "customer-support",
    "softbridge",
    "widget"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
